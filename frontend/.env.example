# Local development: leave empty (the Vite dev server forwards /api to http://localhost:8000).
# Vercel: set this to your Render API URL, with no trailing slash, e.g. https://aerotrack-api.onrender.com
VITE_API_URL=

# Show the one-click demo accounts on the login page. Set to false for a real deployment.
VITE_DEMO_LOGINS=true
