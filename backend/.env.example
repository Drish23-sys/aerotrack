# Copy to .env and edit.
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aerotrack
# Neon / other hosted Postgres (SSL required):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/aerotrack?sslmode=require

# Long random string used to sign login tokens:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# Exact origin(s) of the frontend, comma separated (no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Optional: also allow Vercel preview deployments, e.g.  https://aerotrack-.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# Optional: 1 = also enforce role_admin / role_inspector / role_viewer inside PostgreSQL
ENFORCE_DB_ROLES=0
